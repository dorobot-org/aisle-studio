#!/usr/bin/env python3
"""Octos app-skill entry point for the prepared AISLE simulation task."""

import json
import os
import sys
from urllib.request import Request, urlopen


def invoke(tool, args):
    if tool != "run_task":
        raise ValueError("Choose run_task")
    url = os.environ["AISLE_SPEC_BRIDGE_URL"] + "/tools/vendor.dorobot.aisle.task.run"
    request = Request(
        url,
        data=json.dumps({"args": args}).encode(),
        headers={"Content-Type": "application/json"},
    )
    with urlopen(request, timeout=600) as response:
        return json.load(response)


if __name__ == "__main__":
    try:
        reply = invoke(sys.argv[1], json.load(sys.stdin))
        print(json.dumps({"success": reply["ok"], "output": json.dumps(reply)}))
    except Exception as exc:
        print(json.dumps({"success": False, "output": str(exc)}))
